	quests: [
		{
			description: [
				"&a末地接口（EnderIO）&f以&a导管系统&f闻名：一根导管占一格，却能把物品+流体+能量+红石+气体叠加在同一格里，是包内最省空间的物流。"
				""
				"它还提供：合金熔炼/SAG 磨粉、电容加速机器、灵魂绑定、传送石碑、光电太阳能、真空收集等便利设备。"
				""
				"本章结构：总览 → 合金材料 → 加工机器 → 导管大全 → 发电与电容 → 灵魂与传送 → 实用机器 → 实战。"
			]
			icon: "enderio:item_conduit"
			id: "19E1FED5FC76C4FD"
			shape: "hexagon"
			size: 1.5d
			subtitle: "导管之王与实用机器"
			tasks: [{
				id: "4DA2BB1C0B22FFFA"
				title: "末地接口总览"
				type: "checkmark"
			}]
			title: "末地接口总览"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["19E1FED5FC76C4FD"]
			description: [
				"EnderIO 有自己的合金链（都在合金熔炼炉里合成）："
				""
				"· &a导电合金&f（conductive_alloy_ingot）：电线/能量导管；"
				""
				"· &a脉冲合金&f（pulsating_alloy_ingot）：机器框架核心；"
				""
				"· &a振动合金&f（vibrant_alloy_ingot）：高端导管/组件；"
				""
				"· &a红石合金&f（redstone_alloy_ingot）：红石导管；"
				""
				"· &a能量合金&f（energetic_alloy_ingot）：发电/光伏；"
				""
				"· &a暗钢&f（dark_steel_ingot）：工具/装备；&a末钢&f（end_steel_ingot）：终极材料；&a灵魂钢&f（soularium_ingot）：灵魂相关。"
			]
			id: "4D0E78056E10343F"
			rewards: [{
				id: "3D49C93E61739116"
				type: "xp"
				xp: 10
			}]
