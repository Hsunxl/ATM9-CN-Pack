		}
		{
			dependencies: ["02D39815DDD3158A"]
			description: [
				"&a离心分离器（Centrifugal Separator）&f把混合物甩成多种产物（矿物砂 / 植物 / 废料分离）。"
				""
				"它是产线的「第三段」：磨粉 → 熔炼 → 离心，把副产物料再分离出可用资源。"
				""
				"进阶：离心分离处理矿渣 / 沥青 / 油砂，把废料变宝。"
				""
				"提示：JEI 查「离心」配方看每种物料的产出。"
			]
			id: "5913F7AE31348711"
			rewards: [{
				id: "0EA0DC20E7F1F3B2"
				type: "xp"
				xp: 15
			}]
			subtitle: "物料分离副产"
