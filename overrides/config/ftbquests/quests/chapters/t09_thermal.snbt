	quest_links: [ ]
	quests: [
		{
			description: [
				"热力系列（Thermal）是老牌科技包：机器（磨粉 / 熔炼 / 锯木 / 离心 / 坩埚 / 精炼 / 培育等）+ 能源炉（Dynamo）+ 能量 / 流体导管 + 通量工具。"
				""
				"它强在「全能 + 统一」：所有机器吃 FE，配方直观，和任何 FE 模组无缝兼容，是本包加工与发电的主力。"
				""
				"本章路线：总览 → 机器线 → 能源炉线 → 材料线 → 导管储能线 → 工具线 → 升级附件 → 事例设施 → 实战。"
				""
				"提示：热力系列分基础 / 创新等子模组，机器在 thermal 命名空间下，JEI 全部可查。"
			]
			icon: "thermal:machine_pulverizer"
			id: "209A4404BA9FDB34"
			shape: "hexagon"
			size: 1.5d
			subtitle: "经典科技加工全家桶"
			tasks: [{
				id: "3122772781774C63"
				title: "热力系列概览"
				type: "checkmark"
			}]
			title: "热力系列概览"
			x: 4.5d
			y: 0.0d
		}
		{
			dependencies: ["209A4404BA9FDB34"]
			description: [
				"&a磨粉机（Pulverizer）&f把原矿磨成 2 份矿粉（2 倍增产），还能磨骨粉、沙子、各种物料。"
				""
				"它是热力产线的第一环：原矿 → 磨粉 → 矿粉 → 熔炼，矿石利用率翻倍。"
				""
				"用法：接 FE 电，原矿从上方进，矿粉从下方出，管道自动分流。"
				""
				"进阶：插速度 / 辅助处理升级，磨粉更快、副产更多。"
			]
			id: "03DB4F09C5BA1642"
			rewards: [{
				id: "361CAF021CB7FD03"
				type: "xp"
				xp: 10
			}]
			subtitle: "矿石二倍增产的经典"
			tasks: [{
				id: "1AD399517C6F627F"
				item: "thermal:machine_pulverizer"
				type: "item"
			}]
			title: "磨粉机"
			x: 4.5d
			y: 1.5d
		}
		{
			dependencies: ["03DB4F09C5BA1642"]
			description: [
				"&a感应熔炼炉（Induction Smelter）&f是热力核心熔炼机：矿粉烧锭 + 副产；还能「合金熔炼」——两种料一起烧出合金。"
				""
				"经典合金：&b铜 + 锡 → 青铜&f、&b铁 + 镍 → 因瓦&f、&b金 + 银 → 电子合金&f、&b铜 + 镍 → 康铜&f。"
				""
				"进阶：感应熔炼炉是热力一切合金的来源，青铜 / 因瓦 / 电子合金 / 康铜都靠它。"
				""
				"提示：加副产物升级，金矿 / 银矿会额外出其他矿粒。"
			]
			id: "02D39815DDD3158A"
			rewards: [{
				id: "283A005412883961"
				type: "xp"
				xp: 15
			}]
			subtitle: "合金与副产核心"
			tasks: [{
				id: "3F02C6E9DF312826"
				item: "thermal:machine_smelter"
				type: "item"
			}]
			title: "感应熔炼炉"
			x: 4.5d
			y: 3.0d
		}
		{
			dependencies: ["02D39815DDD3158A"]
			description: [
				"&a通量熔炉（Redstone Furnace）&f用 FE 电力烧炼，比原版熔炉快得多，不用烧煤。"
				""
				"适合处理大量普通矿石 / 食物 / 沙子，和感应熔炼炉分工：通量炉「单一烧炼」，感应炉「合金 + 副产」。"
				""
				"进阶：通量炉 + 自动进料 = 全自动烧炼站，产物接管道进仓库。"
				""
				"提示：它是最基础的热力机器，前期做一个应急。"
			]
			id: "462C8C49F65EDCEE"
			rewards: [{
				id: "1154EDB476FAF618"
				type: "xp"
				xp: 10
			}]
			subtitle: "电力烧炼"
			tasks: [{
				id: "1CDE4860C5EEFCC0"
				item: "thermal:machine_furnace"
				type: "item"
			}]
			title: "通量熔炉"
			x: 0.0d
			y: 4.5d
		}
		{
			dependencies: ["02D39815DDD3158A"]
			description: [
				"&a锯木机（Sawmill）&f把原木切成更多木板（比手合成划算），副产木屑。"
				""
				"木屑可做燃料 / 纸浆；木板是建筑和合成的大宗材料。"
				""
				"进阶：锯木机 + 自动农场（树苗）= 木材自由。"
				""
				"提示：它也能处理部分植物类物品，JEI 查配方。"
			]
			id: "7611AC150818CDEA"
			rewards: [{
				id: "4AEFA3C0D05A2EBB"
