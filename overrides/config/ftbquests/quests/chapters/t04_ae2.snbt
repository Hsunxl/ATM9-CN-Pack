	quest_links: [ ]
	quests: [
		{
			description: [
				"应用能源2（AE2）是本包&a数字存储与自动合成&f核心：物品变成「数据」存进 ME 网络，要什么自动合成什么。"
				""
				"核心概念：&aME 网络&f（控制器/驱动器/终端/线缆组成的局域网）、&a频道Channels&f（限流）、&a能量AE/t&f、&a存储组件&f（决定容量）、&a样板&f（自动合成配方）。"
				""
				"它解决的问题：告别满箱杂物，全基地物品数字化、一键搜索、自动补产。"
				""
				"本章路线：总览 -> 材料（石英/压印/处理器）-> 存储（驱动器/组件/单元）-> 终端 -> 线缆总线 -> 自动合成 -> 高级（量子/P2P/空间）-> 附属 -> 事例 -> 多方块 -> 实战。"
			]
			icon: "ae2:controller"
			id: "39B0ACD4878C1845"
			shape: "hexagon"
			size: 1.5d
			subtitle: "物品即数据的数字网络"
			tasks: [{
				id: "5DAC4C8C0FC86D82"
				title: "应用能源2总览"
				type: "checkmark"
			}]
			title: "应用能源2总览"
			x: 0.0d
			y: 7.5d
		}
		{
			dependencies: ["39B0ACD4878C1845"]
			description: [
				"&a赛特斯石英（Certus Quartz Crystal）&f在主世界矿脉或陨石旁开采；磨成&c石英尘&f后烧制可得水晶。"
				""
				"它是 ME 网络一切材料的源头；&c充能赛特斯&f、&c福鲁伊克斯&f都由它派生。"
				""
				"用&c陨星罗盘（Meteorite Compass）&f可找到陨石，里面有&c星空石&f和大量赛特斯。"
			]
			id: "694A01D755E249B9"
			rewards: [{
				id: "5AB3D4CA1AF29922"
				type: "xp"
				xp: 10
			}]
			subtitle: "Certus Quartz"
			tasks: [{
				id: "428E360C6E7BC2D0"
				item: "ae2:certus_quartz_crystal"
				type: "item"
			}]
			title: "赛特斯石英：材料起点"
			x: 1.5d
			y: 7.5d
		}
		{
			dependencies: ["694A01D755E249B9"]
			description: [
				"&a压印机（Inscriber）&f是 AE2 的加工机器：上下放&c压印板&f（逻辑板/计算板/工程板/硅板/命名板），中间放材料，压出印刷电路。"
				""
				"压印板：&clogic_processor_press / calculation_processor_press / engineering_processor_press / silicon_press / name_press。"
				""
				"它本身不需要接 ME 网络，前期手工放材料即可；后期可被接口自动化。"
			]
			id: "63C68E0CA7D4751B"
			rewards: [{
				id: "093C64195D4E40BF"
				type: "xp"
				xp: 10
			}]
			subtitle: "Inscriber"
			tasks: [{
				id: "4421420F0DDBCB39"
				item: "ae2:inscriber"
				type: "item"
			}]
			title: "压印机与压印板"
			x: 3.0d
			y: 6.0d
		}
		{
			dependencies: ["63C68E0CA7D4751B"]
			description: [
				"&a逻辑处理器（Logic）、计算处理器（Calculation）、工程处理器（Engineering）&f是终端、驱动器、合成单元的核心零件。"
				""
				"链：&c印刷硅片（Printed Silicon）&f + 对应印刷电路（Printed Logic/Calc/Engineering）+ 福鲁伊克斯 -> 处理器。"
				""
				"三种都要大量囤，后期每个终端/接口都消耗它们。"
			]
			id: "475931CB4BFEF3FE"
			rewards: [{
				id: "66D088903DDBA14A"
				type: "xp"
				xp: 10
			}]
