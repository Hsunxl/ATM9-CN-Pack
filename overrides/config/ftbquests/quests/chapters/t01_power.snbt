	quests: [
		{
			description: [
				"本包所有科技机器都吃同一种电：&aFE&f。Powah 发电、通用机械输电、热力储能、AE2 用电，自由混搭、完全互通。"
				""
				"一套电网四要素：&a发电机&f（产出）→ &a线缆&f（传输）→ &a电池&f（缓冲）→ &a机器&f（消耗）。"
				""
				"本章主修三条线：&aPowah&f（最顺手的一键式电源）、&a通量网络&f（无线电网）、&a通用机械发电机&f（多场景）。"
				""
				"分支说明：总览→Powah 全套（任务1-15）、通量无线网络（任务16-19）、通用机械发电（任务20-29），最后汇合到结尾实战（任务30）。"
			]
			icon: "powah:energy_cell_starter"
			id: "26D949C5883016D5"
			shape: "hexagon"
			size: 1.5d
			subtitle: "发电→输电→储能→用电"
			tasks: [{
				id: "6F605A9908EC2ADB"
				title: "电力入门：FE 体系"
				type: "checkmark"
			}]
			title: "电力入门：FE 体系"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["26D949C5883016D5"]
			description: [
				"&a熔炉发电机（Furnator）&f是 Powah 最基础的发电机：放入煤、木炭等固体燃料即发电，开局就能做。"
				""
				"Powah 有等级体系：&a起步(starter)→基础(basic)→硬化(hardened)→炽热(blazing)→niotic→spirited→nitro→创造&f，等级越高发电越快、缓存越大，且支持原地升级（JEI 查升级配方）。"
				""
				"进阶：用漏斗/管道自动往燃料槽塞煤，把能量用线缆接进电池，就是第一套「自动供电系统」。"
				""
				"燃料：煤/木炭最通用；后期可改烈焰棒、煤炭块等高热值燃料。"
			]
			id: "1191D97C744BBAE4"
			rewards: [{
				id: "738E0EB4E056E441"
				type: "xp"
				xp: 10
			}]
			subtitle: "烧燃料，出电力"
			tasks: [{
				id: "4C6CB067EF6E2E15"
				item: "powah:furnator_starter"
				type: "item"
			}]
			title: "第一台发电机：熔炉发电机"
			x: 4.5d
			y: 1.5d
		}
		{
			dependencies: ["1191D97C744BBAE4"]
			description: [
				"Powah 全部设备（发电机/电池/线缆/传送器）都分 starter→basic→hardened→blazing→niotic→spirited→nitro→creative。"
				""
				"核心元件是&a电容(Capacitor)&f与&a水晶(Crystal)&f：capacitor_basic/hardened/blazing/niotic/nitro，crystal_blazing/niotic/spirited/nitro，等级越高机器产出/缓存越大。"
				""
				"升级做法：用对应等级的电容+机器在工作台/装配台合成「升级版」，旧机器不浪费，直接换。"
				""
				"线缆等级决定&a最大传输速率&f：起步级只够小网络，基地扩大后换 blazing/nitro 线缆。"
			]
			icon: "powah:capacitor_blazing"
			id: "72E58038F36EC971"
			rewards: [{
				id: "76528CA2DDF00C4A"
				type: "xp"
				xp: 10
			}]
			subtitle: "别拆旧机器，直接升"
			tasks: [{
				id: "5A02FF1A8B3AD3C6"
				title: "Powah 的等级与原地升级"
				type: "checkmark"
			}]
			title: "Powah 的等级与原地升级"
			x: 0.0d
			y: 3.0d
		}
		{
			dependencies: ["1191D97C744BBAE4"]
			description: [
				"&a岩浆发电机（Magmator）&f消耗岩浆（或岩浆膏）发电，不需要固体燃料。"
				""
				"最大好处是&a稳定&f：持续供岩浆就不断电。去下界放泵抽岩浆，或做岩浆农场刷岩浆膏。"
				""
				"进阶：用流体管道把岩浆从储罐源源不断送入，配合能量管道输出，是中期非常省心的电源。"
				""
				"小技巧：岩浆膏烧成岩浆再喂，等价于「半无限燃料」。"
			]
			id: "5938DE4A49AA180F"
			rewards: [{
				id: "6C53F425094A0262"
				type: "xp"
				xp: 10
			}]
			subtitle: "只喝岩浆，不挑燃料"
			tasks: [{
				id: "5CCDA7B8D6730BA6"
				item: "powah:magmator_starter"
				type: "item"
			}]
			title: "岩浆发电机"
			x: 3.0d
			y: 3.0d
		}
		{
			dependencies: ["1191D97C744BBAE4"]
			description: [
				"&a热力发电机（Thermo Generator）&f利用「热源+冷源」温差发电：底下放岩浆（或烈焰粉加热），上面放水/雪/冰，持续产出。"
				""
				"它是最适合挂机的电源之一：热源用岩浆管道持续供给，冷源保持一格水，之后不用管。"
				""
				"配套元件：&a热电板(thermoelectric_plate)&f与&a绝缘套管(dielectric_*)&f是升级它到高级的材料。"
			]
