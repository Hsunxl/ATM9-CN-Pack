	quest_links: [ ]
	quests: [
		{
			description: [
				"&a新生魔艺 Ars Nouveau&f 是一套「自由拼法术」的魔法模组：你不是背技能表，而是用&a字形 Glyph&f 在雕刻台上自己拼法术。"
				""
				"核心资源是&a魔源 Source&f（蓝绿色法力），由魔源瓶存储、中继器传输、源质链接生成；法术书右键释放，耗魔源、有冷却。"
				""
				"本章五条线：&a魔源体系&f（生成/存储/传输）→ &a法术书写&f（形态+效果+修饰拼字形）→ &a施法与炮塔&f → &a召唤与仪式&f → &a装备与源质链接&f。"
				""
				"分支说明：总览→新手入门（任务1-4）→实用技巧（任务5-8）→物品大全（任务9-44）→事例设施（45-46）→机器结构（47-48）→结尾实战（49）。"
			]
			icon: "ars_nouveau:worn_notebook"
			id: "4EE1B103AB20A3A9"
			shape: "hexagon"
			size: 1.5d
			subtitle: "魔源·字形·召唤·仪式"
			tasks: [{
				id: "55912015C6DD3023"
				title: "新生魔艺总览"
				type: "checkmark"
			}]
			title: "新生魔艺总览"
			x: 0.0d
			y: 6.0d
		}
		{
			dependencies: ["4EE1B103AB20A3A9"]
			description: [
				"&a磨损的笔记本（Worn Notebook）&f是新生魔艺的内置手册，开局就能做，里面写清了所有字形、方块、仪式、召唤的配方与用法。"
				""
				"卡关时先翻它：字形怎么组合、仪式怎么摆、源质链接怎么接，都有图文说明。比 JEI 更懂这个模组。"
				""
				"做一本放背包，比查 wiki 还快。"
			]
			id: "1BBB6B92C58352C6"
			rewards: [{
				id: "22D6968F14C1A0EE"
				type: "xp"
				xp: 10
			}]
			subtitle: "一切配方与机制都在里面"
			tasks: [{
				id: "18BBE5D16F34FF44"
				item: "ars_nouveau:worn_notebook"
				type: "item"
			}]
			title: "随身手册：Worn Notebook"
			x: 1.5d
			y: 6.0d
		}
		{
			dependencies: ["1BBB6B92C58352C6"]
			description: [
				"&a新手法术书（Novice Spell Book）&f是入门级施法工具，自带几个基础法术槽，右键即可释放。"
				""
				"法术书等级：novice → apprentice（学徒）→ archmage（大法师）→ creative，等级越高法术槽越多、复杂度上限越高。"
				""
				"书本身不施法，真正的法术是你在&a雕刻台（Scribes Table）&f里用字形拼出来后写进书里的。"
			]
			id: "3F4CAC14791F2434"
			rewards: [{
				id: "5FB8087561B1BDED"
				type: "xp"
				xp: 10
			}]
			subtitle: "你的第一本 Spell Book"
			tasks: [{
				id: "181CA4E07A9E6483"
				item: "ars_nouveau:novice_spell_book"
				type: "item"
			}]
			title: "新手法术书"
			x: 3.0d
			y: 4.5d
		}
		{
			dependencies: ["1BBB6B92C58352C6"]
			description: [
				"&a魔源宝石（Source Gem）&f是新生魔艺的基础材料，由魔源矿石烧炼或魔源浆果合成，做机器、字形、装备都要它。"
				""
				"玩家头顶有一条&a魔源条&f（蓝色）：施法消耗魔源，不施法时自动回复；上限通过装备/护符提升。"
				""
				"魔源宝石块（Source Gem Block）是储能装饰方块，也方便堆放。"
			]
			id: "5A06ADDE62A5E0DF"
			rewards: [{
				id: "41D76843F5CF1D67"
				type: "xp"
				xp: 10
			}]
			subtitle: "魔法世界的法力值"
			tasks: [{
