	quest_links: [ ]
	quests: [
		{
			description: [
				"植物魔法（Botania）不依赖 FE，而用&a魔力（Mana）&f驱动：生成花产魔力 -> 发射器/火花传输 -> 魔力池存储 -> 功能花/祭坛/装备消费。"
				""
				"核心概念：&a生成花（产魔）&f、&a功能花（干活）&f、&a魔力池（储能）&f、&a发射器/火花（传输）&f、&a泰拉钢/元素钢（高级材料）&f、&a符文/精灵门（进阶）&f。"
				""
				"它解决的问题：用一套「花园即工厂」的体系实现自动农场、自动采矿、物品网络，并产出泰拉/精灵级装备。"
				""
				"本章路线：总览 -> 基础（活石/花药台/手册）-> 魔力传输存储 -> 生成花 -> 功能花 -> 材料装备 -> 符文/泰拉钢 -> 精灵门/盖亚 -> 饰品武器 -> Corporea -> 事例 -> 实战。"
				""
				"最重要工具：&c植物魔法辞典（Lexica Botania）&f，遇到不懂先翻书。"
			]
			icon: "botania:lexicon"
			id: "5A22AB1E6A4B6179"
			shape: "hexagon"
			size: 1.5d
			subtitle: "用魔力而不是电力"
			tasks: [{
				id: "335DF9BA119973A9"
				title: "植物魔法总览"
				type: "checkmark"
			}]
			title: "植物魔法总览"
			x: 9.0d
			y: 0.0d
		}
		{
			dependencies: ["5A22AB1E6A4B6179"]
			description: [
				"&a纯白雏菊（Pure Daisy）&f放在圆石/原木旁，圆石慢慢变成&c活石（Livingrock）&f、原木变成&c活木（Livingwood）&f。"
				""
				"活石/活木是几乎所有植物魔法方块（花药台、魔力池、发射器）的材料。"
				""
				"它是被动花，不需要魔力，零门槛入门。"
			]
			id: "5B885DA77AC8A3C9"
			rewards: [{
				id: "6EC0F5DD9C8686E8"
				type: "xp"
				xp: 10
			}]
			subtitle: "点石成金"
			tasks: [{
				id: "6E503D3EAFD65DBC"
				item: "botania:pure_daisy"
				type: "item"
			}]
			title: "纯白雏菊·活石·活木"
			x: 9.0d
			y: 1.5d
		}
		{
			dependencies: ["5B885DA77AC8A3C9"]
			description: [
				"&a花药台（Petal Apothecary）&f：倒水后按配方放入花瓣+材料，合成各种魔法花。"
				""
				"花瓣来源：剪&c神秘花（16 色）&f得到各色花瓣；查辞典里「花之配方」即可。"
				""
				"合成后台自动空出，可流水线合成；不同生物群系有不同外观的花药台变体。"
			]
			id: "52DC85DBC01F0BA3"
