	quest_links: [ ]
	quests: [
		{
			description: [
				"气动工艺（PneumaticCraft）用 &a压缩空气（bar 气压）&f作为能源：压缩机把空气压进管道，存进压力容器，驱动工具、无人机、组装机。"
				""
				"特色系统：&b压力（bar）&f——气压过高会爆炸；&b热系统&f——加热 / 制冷；&b编程无人机&f——拼图式编程；&b石油分馏&f；&b气动护甲&f。"
				""
				"本章路线：总览 → 压缩铁与压力腔室 → 压缩机与管道 → 工具护甲 → PCB 与组装机 → 石油与热力学 → 无人机与物流 → 发电机 → 事例 → 实战。"
				""
				"提示：游戏内 &a气动工艺手册（pneumaticcraft:manual）&f随进度解锁，带大量图示，强烈建议边玩边读。"
			]
			icon: "pneumaticcraft:ingot_iron_compressed"
			id: "22E239B8FE5F1DA7"
			shape: "hexagon"
			size: 1.5d
			subtitle: "压缩空气驱动一切"
			tasks: [{
				id: "03F9F714E06E9568"
				title: "气动工艺概览"
				type: "checkmark"
			}]
			title: "气动工艺概览"
			x: 0.0d
			y: 3.0d
		}
		{
			dependencies: ["22E239B8FE5F1DA7"]
			description: [
				"&a压缩铁锭（Compressed Iron Ingot）&f由铁锭在 &a压力腔室&f中高压压缩而成，是气动工艺几乎所有方块 / 工具的材料。"
				""
				"它是一切的起点：没有压缩铁就没有压缩机、管道、护甲、无人机。"
				""
				"进阶：前期可以用「爆裂铁」（把铁丢进爆炸里小概率得）应急，但正规途径是压力腔室。"
				""
				"提示：先搭一个最小压力腔室（见任务 4），批量压缩铁锭。"
			]
			id: "359AAAF4D990B2CE"
			rewards: [{
				id: "73CA593C96270A5A"
				type: "xp"
				xp: 10
			}]
			subtitle: "气动工艺的基石"
			tasks: [{
				id: "3B88386D6BBCE39A"
				item: "pneumaticcraft:ingot_iron_compressed"
				type: "item"
			}]
			title: "压缩铁锭"
			x: 1.5d
			y: 3.0d
		}
		{
			dependencies: ["359AAAF4D990B2CE"]
			description: [
				"&a压缩铁块（Compressed Iron Block）&f用于大型结构 / 储能；&a压缩铁齿轮（Compressed Iron Gear）&f是组装机、机器的常见零件。"
				""
				"此外还有 &a压缩石头（Compressed Stone）&f、&a压缩砖 / 强化砖&f等建筑与耐压材料。"
				""
				"进阶：攒一组压缩铁块和齿轮，中后期做机器就不慌。"
				""
				"提示：compressed_bricks / reinforced_bricks 是做高压结构的方块。"
			]
			id: "236B7BF480D0CF6B"
			rewards: [{
				id: "461D0B052CD846C6"
				type: "xp"
				xp: 10
			}]
			subtitle: "机器的结构件"
			tasks: [{
				id: "3CBC436B7468E24A"
				item: "pneumaticcraft:compressed_iron_gear"
				type: "item"
			}]
			title: "压缩铁块与齿轮"
			x: 3.0d
			y: 1.5d
		}
		{
			dependencies: ["359AAAF4D990B2CE"]
			description: [
				"&a压力腔室墙（Pressure Chamber Wall）&f和 &a压力腔室玻璃（Pressure Chamber Glass）&f是搭建密闭腔室的壁材。"
				""
				"腔室必须完全密封（六面都用壁 / 玻璃封死，不能有缺口），否则充不进高压。"
				""
				"进阶：壁材等级决定耐压上限，高压配方需要更坚固的壁。"
				""
				"提示：先用 3x3x3 小腔室练手，再放大。"
			]
			id: "0D24A2D1306A2376"
			rewards: [{
				id: "741E9A0BE8C64F4F"
				type: "xp"
				xp: 10
			}]
			subtitle: "多方块的外壳"
			tasks: [{
				id: "1E52A8401A4A4755"
				item: "pneumaticcraft:pressure_chamber_wall"
				type: "item"
			}]
			title: "压力腔室：墙壁与玻璃"
			x: 3.0d
			y: 3.0d
		}
		{
			dependencies: ["0D24A2D1306A2376"]
			description: [
				"&a压力腔室阀（Pressure Chamber Valve）&f是唯一能把高压空气导入腔室的方块，贴在腔室外壁，接压力管道。"
				""
				"&a压力腔室接口（Pressure Chamber Interface）&f用于从腔室外部放 / 取物品（不用破墙）。"
				""
				"搭建顺序：先用墙 / 玻璃围成密闭空间 → 装一个阀接气管 → 装一个接口存取物品。"
				""
				"进阶：JEI 筛「压力腔室」配方可查所有需要高压合成的物品（压缩铁、PCB 等）。"
			]
			id: "5D0DA8D171FC7CEB"
			rewards: [{
				id: "744EE7AABC1983CF"
				type: "xp"
				xp: 10
			}]
			subtitle: "进气与存取"
			tasks: [{
				id: "4D67BEA1787809E6"
				item: "pneumaticcraft:pressure_chamber_valve"
				type: "item"
			}]
			title: "压力腔室：阀与接口"
			x: 4.5d
			y: 3.0d
		}
		{
			dependencies: [
				"0D24A2D1306A2376"
				"5D0DA8D171FC7CEB"
			]
			description: [
				"&a压力腔室（Pressure Chamber）&f是气动工艺的核心多方块，搭建要点："
				""
				"1. 用 &b压力腔室墙 / 玻璃&f围成一个任意大小的密闭空间（最小 3x3x3）；"
				""
				"2. 至少一个 &b压力腔室阀&f朝外，用来接高压空气；"
				""
				"3. 至少一个 &b压力腔室接口&f，用来从外部存取物品；"
				""
				"4. 接口 / 阀不能漏气——密封不严会持续掉压；"
				""
				"5. 用压缩机往阀里打气，腔室气压升高后，内部物品按「高压配方」反应（如铁锭→压缩铁）。"
				""
				"不同配方需要不同气压，JEI 可查；气压越高配方越多但越危险。"
			]
			icon: "pneumaticcraft:pressure_chamber_glass"
			id: "08A68979606599B9"
			rewards: [{
				id: "058C4345B20C2879"
				type: "xp"
				xp: 15
			}]
			subtitle: "第一个多方块结构"
			tasks: [{
				id: "764FF605960F0321"
				title: "多方块：搭建压力腔室"
				type: "checkmark"
			}]
			title: "多方块：搭建压力腔室"
			x: 6.0d
			y: 4.5d
		}
		{
			dependencies: ["5D0DA8D171FC7CEB"]
			description: [
				"&a空气压缩机（Air Compressor）&f烧固体燃料（煤 / 木炭）把空气压进相邻压力管道，是最基础的气源。"
				""
				"&a手动压缩机（Manual Compressor）&f前期用手压，应急做第一罐空气。"
				""
				"用法：压缩机贴管道，管道接压力腔室阀 / 储罐，烧煤即可升压。"
				""
				"进阶：多台压缩机并联，气压涨得更快。"
			]
			id: "02F1373D1E1CDB6C"
			rewards: [{
				id: "53823A07DD6BD53D"
				type: "xp"
				xp: 10
			}]
			subtitle: "烧燃料压空气"
			tasks: [{
