	quests: [
		{
			description: [
				"本章教你把「一堆散落箱子」升级成「一套仓库」，三条路线："
				""
				"· &b功能存储（Functional Storage）&f：一槽一种物品、容量巨大的抽屉，适合大宗原料；"
				""
				"· &b精巧存储（Sophisticated Storage）&f：可装升级模块的智能箱子 / 背包，单箱多功能；"
				""
				"· &b精致存储（Refined Storage, RS）&f：数字网络 + 自动合成，点一下就能取货 / 下单合成；"
				""
				"本章路线：总览 → 抽屉线 → 智能箱线 → RS 线 → 三方对比与互联 → 事例 → 实战。"
				""
				"建议：前期抽屉 + 智能箱起步，中期上 RS 数字网络，三者可并存互联。"
			]
			icon: "minecraft:chest"
			id: "2D464938CA84B1D6"
			shape: "hexagon"
			size: 1.5d
			subtitle: "从箱子到数字仓库"
			tasks: [{
				id: "689C0BA8A14D35FE"
				title: "存储思路总览"
				type: "checkmark"
