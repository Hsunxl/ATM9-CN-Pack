	progression_mode: "flexible"
	quest_links: [ ]
	quests: [
		{
			description: [
				"机械动力（Create）不用 FE 电网，而用&a旋转应力&f（Stress Units，SU）驱动：动力源旋转 -> 轴/齿轮/皮带传动 -> 磨石、粉碎轮、压机等加工机器。"
				""
				"核心概念三件事：&a应力SU&f（扭矩，决定能带几台机器）、&a转速RPM&f（决定单机快慢）、&a动力源与传动&f（水车/风车/蒸汽机 -> 轴 -> 机器）。"
				""
				"它解决的问题：把「手搓物品」变成「看得见运转的自动化流水线」，并通过&a机械臂、机械合成器、列车&f与 AE2/RS 存储对接，成为中期工厂骨架。"
				""
				"本章路线：总览 -> 入门材料 -> 工具 -> 动力源 -> 传动 -> 加工机器 -> 物流 -> 流体 -> 红石自动化 -> 移动结构 -> 列车 -> 工具建造 -> 事例 -> 多方块 -> 综合实战。"
				""
				"学习捷径：游戏内对任意机械方块按 &aW&f 打开 Ponder 动画，逐帧看它怎么转，比读任何文字都直观。"
			]
			icon: "create:goggles"
			id: "08FAC959FFF939E0"
			shape: "hexagon"
			size: 1.5d
			subtitle: "旋转、传动与看得见的工厂"
			tasks: [{
				id: "1C255BC73E40E4A0"
				title: "机械动力总览"
				type: "checkmark"
			}]
			title: "机械动力总览"
			x: 15.0d
			y: 0.0d
		}
		{
			dependencies: ["08FAC959FFF939E0"]
			description: [
				"&a安山合金（Andesite Alloy）&f由安山岩+铁粒合成，是轴、齿轮、曲柄、漏斗的基础零件。"
				""
				"刷安山岩：用&a手摇曲柄&f带动&a磨石&f，把圆石磨成沙砾再磨成沙，途中副产安山岩；或直接挖安山岩脉。"
				""
				"前期优先做：&a工程师护目镜&f（看应力转速）、&a扳手&f（旋转/拆卸方块），再开始铺第一条轴。"
				""
				"进阶：&a安山合金块&f与&c安山机壳&f是后期机械外壳材料。"
			]
			id: "6D5D7659AEB1CE8B"
			rewards: [{
				id: "7A1D2910554B2365"
				type: "xp"
				xp: 10
			}]
			subtitle: "安山岩 + 铁粒"
			tasks: [{
				id: "6F38A45E246F246A"
				item: "create:andesite_alloy"
				type: "item"
			}]
			title: "安山合金：一切的起点"
			x: 16.5d
			y: 1.5d
		}
		{
			dependencies: ["6D5D7659AEB1CE8B"]
			description: [
				"&a黄铜（Brass）&f= 铜+锌在炉中熔炼；&a锌（Zinc）&f在主世界与铜矿共生，挖&czinc_ore&f烧出锌锭。"
				""
				"&a玫瑰石英（Rose Quartz）&f：打磨紫水晶得到；玫瑰石英 + 黄铜板 -> &a电子管（Electron Tube）&f；电子管+金板 -> &a精密构件（Precision Mechanism）&f。"
				""
				"精密构件是&c机械臂、机械合成器、智能漏斗、列车&f的材料，标志你从「手摇作坊」进入「自动工厂」。"
				""
				"找不到锌就查 JEI：粉碎轮处理铜矿时也有概率副产锌。"
			]
			id: "52B6190F80254442"
			rewards: [{
				id: "79A5AE9679A63946"
				type: "xp"
				xp: 10
			}]
			subtitle: "从毛坯到精密"
			tasks: [{
				id: "6CC297F739701A44"
				item: "create:brass_ingot"
				type: "item"
			}]
			title: "黄铜时代：锌·玫瑰石英·精密构件"
			x: 15.0d
			y: 3.0d
		}
		{
			dependencies: ["6D5D7659AEB1CE8B"]
			description: [
				"&a工程师护目镜（Goggles）&f戴上后看任意轴/齿轮/机器，直接显示当前&a应力SU占用&f与&a转速RPM&f，排障必备。"
				""
				"&a扳手（Wrench）&f：右键旋转机器朝向，潜行右键整体拆卸方块，是布置产线的标准动作。"
				""
				"配合&a应力计（Stressometer）&f与&a速度表（Speedometer）&f可以把数据贴在机器上供观察。"
				""
				"技巧：扳手右键轴可以切换轴/连接器形态，搭线前先戴护目镜。"
			]
			id: "74B8393DABB9BDC8"
			rewards: [{
				id: "02A5F421EB9382EA"
				type: "xp"
				xp: 10
			}]
