	quest_links: [ ]
	quests: [
		{
			description: [
				"工业先锋（Industrial Foregoing）是一套「吃电干活」的实用机器合集：农业自动化、畜牧自动化、激光钻井、怪物处理、经验附魔、黑洞存储、生物发电，几乎包揽日常后勤。"
				""
				"所有机器都消耗 &aFE（红石通量）&f，外壳是 &a机器框架&f：怜悯→简易→高级→至高 四档，档位越高速度越快；在机器 GUI 的升级槽里塞高档框架即可就地升级。"
				""
				"本章路线：总览 → 材料线（乳胶/塑料/框架/粉红史莱姆/溶解室）→ 农牧线 → 激光与怪物线 → 资源处理与存储线 → 升级件与工具 → 事例设施 → 机器结构 → 综合实战。"
				""
				"提示：游戏内有 &a工业先锋手册&f（industrialforegoing:book_manual），合成后随进度解锁详细说明，务必随身携带。"
			]
			icon: "industrialforegoing:machine_frame_simple"
			id: "1C33CBED8C6BA208"
			shape: "hexagon"
			size: 1.5d
			subtitle: "农业、畜牧、采矿、怪物一条龙"
			tasks: [{
				id: "44CDDB57441B41A8"
				title: "工业先锋概览"
				type: "checkmark"
			}]
			title: "工业先锋概览"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["1C33CBED8C6BA208"]
			description: [
				"&a乳胶（Latex）&f由 &a乳胶收集器&f贴在橡胶木原木上采集（模拟割胶）；用桶或流体管道接走。"
				""
				"乳胶烧炼 / 加工成 &a干橡胶（Dry Rubber）&f，再得到 &a小干橡胶粒（Tiny Dry Rubber）&f，是塑料的前身。"
				""
				"进阶：种一排橡胶树 + 一排乳胶收集器 + 漏斗自动收乳胶，就能形成自给自足的橡胶农场。"
				""
				"提示：本包橡胶木由热力基础提供（thermal:rubberwood），可自动育苗种植。"
			]
			id: "0472595C5DFC029D"
			rewards: [{
				id: "2902022D62C04872"
				type: "xp"
				xp: 10
			}]
			subtitle: "工业先锋的起点"
			tasks: [{
				id: "12D54C7482EE086D"
				item: "industrialforegoing:dryrubber"
				type: "item"
			}]
			title: "乳胶与干橡胶"
			x: 6.0d
			y: 1.5d
		}
		{
			dependencies: ["0472595C5DFC029D"]
			description: [
				"干橡胶烧炼成 &a塑料（Plastic）&f，塑料 + 铁锭等合成 &a机器框架&f。"
				""
				"&a机器框架&f分怜悯 / 简易 / 高级 / 至高 四档，是工业先锋几乎所有机器的底座；档位直接决定机器处理速度。"
				""
				"进阶：前期用「怜悯 / 简易」框架足够，等粉红史莱姆和机器外壳攒够了再升「高级 / 至高」。"
				""
				"提示：框架升级是「换壳不换机」——把旧机器拆掉换成高档框架，JEI 查对应配方即可。"
			]
			id: "51F2F1AD2979A580"
			rewards: [{
				id: "7B0FE49FC0A9AE5F"
				type: "xp"
				xp: 10
			}]
			subtitle: "机器的外壳"
			tasks: [{
				id: "0A9DC043A2F6EC24"
				item: "industrialforegoing:machine_frame_simple"
				type: "item"
			}]
			title: "塑料与机器框架"
			x: 6.0d
			y: 3.0d
		}
		{
			dependencies: ["51F2F1AD2979A580"]
			description: [
				"&amachine_frame_pity（怜悯）&f：最廉价起步；&amachine_frame_simple（简易）&f：中期主力。"
				""
				"&amachine_frame_advanced（高级）&f：速度明显提升；&amachine_frame_supreme（至高）&f：极速，需要大量粉红史莱姆。"
				""
				"用法：在已放好的机器 GUI 里把低等级框架取出、放入高等级框架，机器原地升级，不用重做。"
				""
				"进阶：配合后面要讲的 &a速度升级件&f，至高框架机器 = 产能怪物。"
			]
			id: "341BA1A5A9C9A275"
			rewards: [{
				id: "1AE931CB3ADB1FAA"
				type: "xp"
				xp: 10
			}]
			subtitle: "怜悯→简易→高级→至高"
			tasks: [{
				id: "1A28CF0942FB2E4B"
				item: "industrialforegoing:machine_frame_advanced"
				type: "item"
			}]
			title: "框架等级与就地升级"
			x: 1.5d
			y: 4.5d
		}
		{
			dependencies: ["51F2F1AD2979A580"]
			description: [
				"&a粉红史莱姆（Pink Slime）&f是工业先锋特色液体：由 &a屠宰场（Mob Slaughter Factory）&f杀动物收集，凝固成 &a粉红史莱姆锭&f。"
				""
				"粉红史莱姆锭是高级框架、高级升级件的关键材料，没有它升不了至高。"
				""
				"进阶：建「动物繁育→屠宰场」闭环，肉 / 皮革 / 粉红史莱姆三收，材料再也不愁。"
				""
				"提示：粉红史莱姆液体用 pink_slime_bucket 桶接，可走流体管道。"
			]
			id: "5CBF54ECEEB334D5"
			rewards: [{
