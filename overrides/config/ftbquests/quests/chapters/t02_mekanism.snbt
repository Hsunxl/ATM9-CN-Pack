	quest_links: [ ]
	quests: [
		{
			description: [
				"通用机械（Mekanism）是本包&a矿物处理&f核心：同样的矿石榨出 2~5 倍产出，自带能量/流体/气体物流与发电体系。"
				""
				"它引入「&a气体&f」维度：氢、氧、氯、硫酸……用压力管道传输、化学罐存储，是高阶产线的命脉。"
				""
				"本章树状路线："
				""
				"· 主干(任务1-4)：外壳/电路→冶金灌注机→钢与合金；"
				""
				"· 矿物处理(任务5-9, 15-22)：2x→3x→4x→5x 完整产线；"
				""
				"· 工厂与物流(任务23-31)：并行工厂、四类管道、分类、自动合成；"
				""
				"· 采矿/QIO/多方块(任务32-42)：数字矿机、QIO、感应矩阵、锅炉汽轮机、蒸发器、裂变/聚变/SPS；"
				""
				"· 装备工具(任务43-50)：原子分解器、自由跑者、喷气背包、传送、Meka 套装与模块、辐射防护；"
				""
				"结尾(任务51)：把 5 倍矿物处理基地搭起来。"
			]
			icon: "mekanism:atomic_disassembler"
			id: "4E8D0115536BAF2B"
			shape: "hexagon"
			size: 1.5d
			subtitle: "矿物处理之王，气体工业鼻祖"
			tasks: [{
				id: "33CDAC3F4AD56157"
				title: "认识通用机械"
				type: "checkmark"
			}]
			title: "认识通用机械"
			x: 0.0d
			y: 6.0d
		}
		{
			dependencies: ["4E8D0115536BAF2B"]
			description: [
				"&a钢制外壳(Steel Casing)&f是通用机械所有机器的底座；&a基础控制电路(basic_control_circuit)&f是大部分机器的电路部件。"
				""
				"电路升级线：&abasic→advanced→elite→ultimate&a_control_circuit，低级电路是高级电路的材料，别卖。"
				""
				"所有机器的通用升级槽：&aupgrade_speed(速度)&f、&aupgrade_energy(能量)&f、&aupgrade_gas(气体)&f、&aupgrade_filter(过滤)&f、&aupgrade_muffling(消音)&f、&aupgrade_anchor(锚定)&f、&aupgrade_stone_generator(石头发电机升级)&f。"
			]
			id: "7C9901B56D5867D6"
			rewards: [{
				id: "1DA3F226E0D24588"
				type: "xp"
				xp: 10
			}]
			subtitle: "一切机器的底座"
			tasks: [{
				id: "373AEA6E78CDF5B7"
				item: "mekanism:steel_casing"
				type: "item"
			}]
			title: "钢制外壳与控制电路"
			x: 1.5d
			y: 6.0d
		}
		{
			dependencies: ["7C9901B56D5867D6"]
			description: [
				"&a冶金灌注机(Metallurgic Infuser)&f把「金属+灌注材料」合成新材料：铁锭+煤→钢锭，铁+红石→灌注合金等。"
				""
				"它是通用机械最早的自动化机器，也是你第一台需要接电的机器。"
				""
				"用法：一个槽放金属、一个槽放灌注材料（煤/红石等），接电后自动合成；配合漏斗/物流传输器可全自动。"
			]
			id: "5074F3EE33743230"
			rewards: [{
				id: "558BAF2C70D00C63"
				type: "xp"
				xp: 10
			}]
			subtitle: "第一台吃电的机器"
			tasks: [{
				id: "017DC1914A8A33CD"
				item: "mekanism:metallurgic_infuser"
				type: "item"
			}]
			title: "冶金灌注机"
			x: 3.0d
			y: 3.0d
		}
		{
			dependencies: ["5074F3EE33743230"]
			description: [
				"&a钢锭(ingot_steel)&f=铁锭+煤在冶金灌注机里合成，做钢制外壳、高级工具的基础。"
				""
				"三大合金：&a灌注合金(alloy_infused，铁+红石)&f、&a强化合金(alloy_reinforced)&f、&a原子合金(alloy_atomic)&f——分别对应 basic→advanced/elite→ultimate 的机器/线缆升级。"
				""
				"其它锭：&a青铜(ingot_bronze)、&a锡(ingot_tin)、&a铅(ingot_lead)、&a锇(ingot_osmium)、&a铀(ingot_uranium)、&a强化荧石(glowstone)、&a强化黑曜(refined_obsidian)&f。"
			]
