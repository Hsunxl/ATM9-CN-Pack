#!/bin/sh
# 提交前自动隐私体检：发现密钥 / 凭据 / 本机路径就中止提交。
# 启用方式（在仓库根目录执行一次）：
#     git config core.hooksPath .githooks
# 临时跳过： git commit --no-verify

PY=""
for c in python python3 py; do
    if command -v "$c" >/dev/null 2>&1; then
        PY="$c"
        break
    fi
done

if [ -z "$PY" ]; then
    echo "[pre-commit] 未找到 Python，已跳过隐私体检。"
    echo "[pre-commit] 建议手动执行：python tools/check-secrets.py"
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
"$PY" "$ROOT/tools/check-secrets.py" --quiet
exit $?
